# Ledger standalone install. Never commit .env or your data directory.
API_HOST=127.0.0.1
API_PORT=9543
FRONTEND_PORT=9544
LEDGERMIND_PUBLIC_BASE=/
# Optional absolute directory outside your checkout for persistent household data:
# LEDGERMIND_DATA_DIR=/path/to/private/ledger-data
# Login remains enabled. Do not disable authentication on a shared network.

# Deterministic planning works without AI or paid API keys.
# mock provides placeholder responses, not real AI advice.
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_ALLOW_REMOTE_OPENAI=false

# Optional research providers. Leave blank if not used.
FRED_API_KEY=
BLS_API_KEY=
EIA_API_KEY=
# Optional push notifications: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
